{
  "name": "clinic-companion-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/node.ts",
    "deploy": "wrangler deploy",
    "build:node": "tsc -p tsconfig.json",
    "start:node": "node dist/node.js",
